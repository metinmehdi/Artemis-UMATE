# Copy this file to .env and fill in your keys. Never commit .env.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Cloud version (Vercel + Supabase). Not needed for the laptop server.
# Set the same values in Vercel -> Project -> Settings -> Environment Variables.
SUPABASE_URL=
SUPABASE_ANON_KEY=            # publishable key (sb_publishable_...), safe for browsers
SUPABASE_SERVICE_ROLE_KEY=    # secret key (sb_secret_...), server only
UMATE_ACCESS_KEY=             # any long random text; the panel QR code carries it to the phone

# Optional overrides
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_VOICE=marin
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe   (set to "off" to disable user transcripts)
# GEMINI_MODEL=gemini-3.5-flash
# PORT=8443
# HTTP_PORT=8080
# UMATE_TUNNEL=0      (laptop server: do not open a public tunnel)
